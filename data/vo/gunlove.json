[[0.15, "When you fire a bullet"],
 [1.9, "into a round tube,"],
 [2.9, "it comes back."],
 [3.8, "But it's not actually the bullet"],
 [5.5, "that hurts you."],
 [6.6, "What actually hurts"],
 [8.4, "is knowing exactly"],
 [9.75, "who you could have been."],
 [13.95, "Years building in silence."],
 [15.6, "Days doubting yourself."],
 [20.05, "And still, you show up."],
 [21.4, "Nobody sees the roots."],
 [22.8, "Your potential isn't a promise."],
 [24.4, "It's a practice."],
 [28.55, "You'll spend hours planning who you want to be,"],
 [31.75, "but won't spend one hour becoming it."]]
